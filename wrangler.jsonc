// Configuration Cloudflare : publie le dossier _site (le site construit),
// avec un petit aiguilleur (worker/index.js) pour les redirections.
{
  "name": "gmpb-site",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
