---
layout: layouts/base.njk
activeNav: gm
permalink: /gros-budget/
eleventyComputed:
  title: "{{ blog.gm_name }}"
  description: "{{ blog.gm_description }}"
---
{%- import "partials/macros.njk" as m -%}
{%- set arts = collections.articles | byTrack("gm") -%}
<section class="page-hero" style="background:#50C878;color:#0B3D20">
  <div class="wrap">
    <div class="breadcrumb"><a href="/">{{ common.breadcrumb_home }}</a> / {{ blog.gm_name }}</div>
    <h1 class="display h-1">{{ blog.gm_name }}</h1>
    <p class="lead" style="margin-top:20px">{{ blog.gm_description | rich | safe }}</p>
    <div class="btn-row"><a class="btn" href="/petit-budget/">{{ blog.see_also }} {{ blog.pb_name }} →</a></div>
  </div>
</section>
<section class="wrap" style="padding-top:40px;padding-bottom:88px" aria-label="{{ blog.gm_name }}">
  <div class="section-head" style="flex-direction:column;align-items:flex-start">
    {{ m.catFilters("track-grid", "track-count", "track-empty", categories.categories, blog) }}
    <span class="result-count" id="track-count" aria-live="polite"></span>
  </div>
  <div class="grid" id="track-grid">
    {%- for a in arts %}
    {{ m.card(a, categories.categories, blog, true) }}
    {%- endfor %}
  </div>
  <p class="empty" id="track-empty" {% if arts.length %}hidden{% endif %}>{{ blog.empty_track }}</p>
</section>
{{ m.contactBand(site, common) }}
