---
layout: layouts/base.njk
---
<section class="page-hero" style="background:var(--violet-soft)">
  <div class="wrap">
    <div class="breadcrumb"><a href="/">{{ common.breadcrumb_home }}</a> / {{ title }}</div>
    <h1 class="display h-1">{{ title }}</h1>
  </div>
</section>
<section class="wrap-narrow section legal prose">
  {%- if updated %}<p class="muted">{{ common.updated_label }} {{ updated | dateFr }}</p>{% endif %}
  {{ content | safe }}
</section>
