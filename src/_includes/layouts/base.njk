{%- set pageTitle = (seo_title or title) ~ (" — " ~ site.shortTitle if title else "") if not isHome else (home.seo_title or site.title) -%}
{%- set pageDesc = (home.seo_description if isHome else "") or seo_description or description or chapo or site.description -%}
{%- set canonical = page.url | absoluteUrl(site.url) -%}
{%- set ogImage = (cover if cover else "/assets/og-default.png") | absoluteUrl(site.url) -%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc | truncate(160) }}">
<link rel="canonical" href="{{ canonical }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/article.njk' else 'website' }}">
<meta property="og:title" content="{{ (home.seo_title if isHome else "") or seo_title or title or site.title }}">
<meta property="og:description" content="{{ pageDesc | truncate(200) }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.png" type="image/png" sizes="512x512">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css">
{% block head %}{% endblock %}
</head>
<body>
{% include "partials/header.njk" %}
<main id="contenu">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{%- if site.gaId %}
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookies" hidden>
  <p>J'utilise Google Analytics pour savoir quels articles te sont utiles. Ces cookies de mesure ne sont déposés que si tu acceptes. <a href="/confidentialite/#cookies">En savoir plus</a></p>
  <div class="cookie-actions">
    <button type="button" class="btn" data-consent="denied">Refuser</button>
    <button type="button" class="btn btn-yellow" data-consent="granted">Accepter</button>
  </div>
</div>
<script>
(function(){
  var ID = {{ site.gaId | dump | safe }}, KEY = "gmpb-consent", banner = document.getElementById("cookie-banner");
  function get(){ try { return localStorage.getItem(KEY); } catch(e) { return null; } }
  function set(v){ try { localStorage.setItem(KEY, v); } catch(e) {} }
  function loadGA(){
    if (window.gtag) return;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){ dataLayer.push(arguments); };
    gtag("consent", "default", { analytics_storage: "granted", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied" });
    gtag("js", new Date()); gtag("config", ID, { anonymize_ip: true });
    var s = document.createElement("script"); s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(ID);
    document.head.appendChild(s);
  }
  function choose(v){
    set(v); banner.hidden = true;
    if (v === "granted") { loadGA(); }
    else if (window.gtag) { location.reload(); }
  }
  banner.addEventListener("click", function(e){ var b = e.target.closest("[data-consent]"); if (b) choose(b.getAttribute("data-consent")); });
  document.addEventListener("click", function(e){ if (e.target.closest(".js-cookie-settings")) { e.preventDefault(); banner.hidden = false; } });
  var c = get();
  if (c === "granted") loadGA(); else if (c !== "denied") banner.hidden = false;
})();
</script>
{%- endif %}
<script>window.GMPB_TEXTS = {{ { common: common, contact: contact, article: article, blog: blog } | jsonScript | safe }};</script>
<script src="/assets/js/main.js" defer></script>
</body>
</html>
