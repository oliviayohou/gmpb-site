{%- set pageTitle = (seo_title or title) ~ (" — " ~ site.shortTitle if title else "") if not isHome else (home.seo_title or site.title) -%}
{%- set pageDesc = (home.seo_description if isHome else "") or seo_description or description or chapo or site.description -%}
{%- set canonical = page.url | absoluteUrl(site.url) -%}
{%- set ogImage = (cover if cover else "/assets/og-default.png") | absoluteUrl(site.url) -%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc | truncate(160) }}">
<link rel="canonical" href="{{ canonical }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/article.njk' else 'website' }}">
<meta property="og:title" content="{{ (home.seo_title if isHome else "") or seo_title or title or site.title }}">
<meta property="og:description" content="{{ pageDesc | truncate(200) }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css">
{% block head %}{% endblock %}
</head>
<body>
{% include "partials/header.njk" %}
<main id="contenu">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script>window.GMPB_TEXTS = {{ { common: common, contact: contact, article: article, blog: blog } | jsonScript | safe }};</script>
<script src="/assets/js/main.js" defer></script>
</body>
</html>
