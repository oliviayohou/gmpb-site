{# Badge Grand Marketing / Petit Budget #}
{% macro badge(track) -%}
<span class="badge badge-{{ track }}">{{ "GRAND MARKETING" if track == "gm" else "PETIT BUDGET" }}</span>
{%- endmacro %}

{# Visuel d'une carte : l'image de couverture, ou un visuel coloré par défaut #}
{% macro coverBox(a, cat, cls="card-cover") -%}
<div class="{{ cls }}{% if not a.data.cover %} pattern{% endif %}" style="background-color:{{ cat.color }}">
  {%- if a.data.cover %}
  <img src="{{ a.data.cover }}" alt="{{ a.data.cover_alt }}" loading="lazy" decoding="async">
  {%- else %}
  <span class="cover-label" aria-hidden="true">{{ cat.name }}</span>
  {%- endif %}
</div>
{%- endmacro %}

{# Carte d'article #}
{% macro card(a, categories, showExcerpt=false) -%}
{%- set cat = a.data.category | category(categories) -%}
<a class="card" href="{{ a.url }}" data-track="{{ a.data.track }}" data-cat="{{ a.data.category }}">
  {{ coverBox(a, cat) }}
  <div class="card-meta">{{ badge(a.data.track) }}<span>{{ cat.name }}</span><span>· {{ a | readingTime }} min</span></div>
  <h3>{{ a.data.title }}</h3>
  {%- if showExcerpt and a.data.chapo %}
  <p>{{ a.data.chapo | truncate(140) }}</p>
  {%- endif %}
</a>
{%- endmacro %}

{# Filtres Tout / GM / PB #}
{% macro trackFilters(target, countId, emptyId) -%}
<div class="filters" role="group" aria-label="Filtrer par track" data-filter-group data-filter-key="track" data-filter-target="{{ target }}" data-filter-count="{{ countId }}" data-filter-empty="{{ emptyId }}">
  <button type="button" class="chip" data-value="all" aria-pressed="true">Tout</button>
  <button type="button" class="chip" data-value="gm" aria-pressed="false">Grand Marketing</button>
  <button type="button" class="chip" data-value="pb" aria-pressed="false">Petit Budget</button>
</div>
{%- endmacro %}

{# Filtres par catégorie #}
{% macro catFilters(target, countId, emptyId, categories) -%}
<div class="filters" role="group" aria-label="Filtrer par thème" data-filter-group data-filter-key="cat" data-filter-target="{{ target }}" data-filter-count="{{ countId }}" data-filter-empty="{{ emptyId }}">
  <button type="button" class="chip" data-value="all" aria-pressed="true">Tous les thèmes</button>
  {%- for c in categories %}
  <button type="button" class="chip" data-value="{{ c.slug }}" aria-pressed="false">{{ c.name }}</button>
  {%- endfor %}
</div>
{%- endmacro %}

{# Bandeau contact / devis #}
{% macro contactBand(site) -%}
<section class="contact-band" aria-labelledby="cb-title">
  <div class="wrap">
    <div>
      <h2 class="display h-2" id="cb-title">Une idée à appliquer chez toi ?<br><span>Parlons-en.</span></h2>
      <p class="lead" style="margin-top:14px">Une question sur un article, un projet à monter : écris-moi, je te réponds.</p>
    </div>
    <a class="btn btn-yellow" href="/contact/{{ '?type=devis' if site.devis }}">{{ "Demander un devis" if site.devis else "Me contacter" }} →</a>
  </div>
</section>
{%- endmacro %}
