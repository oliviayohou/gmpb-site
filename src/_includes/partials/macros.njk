{# Badge Grand Marketing / Petit Budget #}
{% macro badge(track, blog) -%}
<span class="badge badge-{{ track }}">{{ blog.gm_badge if track == "gm" else blog.pb_badge }}</span>
{%- endmacro %}

{# Visuel d'une carte : l'image de couverture, ou un visuel coloré par défaut #}
{% macro coverBox(a, cat, cls="card-cover") -%}
<div class="{{ cls }}{% if not a.data.cover %} pattern{% endif %}" style="background-color:{{ cat.color }}">
  {%- if a.data.cover %}
  <img src="{{ a.data.cover }}" alt="{{ a.data.cover_alt }}" loading="lazy" decoding="async">
  {%- else %}
  <span class="cover-label" aria-hidden="true">{{ cat.name }}</span>
  {%- endif %}
</div>
{%- endmacro %}

{# Carte d'article #}
{% macro card(a, categories, blog, showExcerpt=false) -%}
{%- set cat = a.data.category | category(categories) -%}
<a class="card" href="{{ a.url }}" data-track="{{ a.data.track }}" data-cat="{{ a.data.category }}">
  {{ coverBox(a, cat) }}
  <div class="card-meta">{{ badge(a.data.track, blog) }}<span>{{ cat.name }}</span><span>· {{ a | readingTime }} {{ blog.reading_time }}</span></div>
  <h3>{{ a.data.title }}</h3>
  {%- if showExcerpt and a.data.chapo %}
  <p>{{ a.data.chapo | truncate(140) }}</p>
  {%- endif %}
</a>
{%- endmacro %}

{# Filtres Tout / GM / PB #}
{% macro trackFilters(target, countId, emptyId, blog) -%}
<div class="filters" role="group" aria-label="Filtrer" data-filter-group data-filter-key="track" data-filter-target="{{ target }}" data-filter-count="{{ countId }}" data-filter-empty="{{ emptyId }}">
  <button type="button" class="chip" data-value="all" aria-pressed="true">{{ blog.filter_all }}</button>
  <button type="button" class="chip" data-value="gm" aria-pressed="false">{{ blog.gm_name }}</button>
  <button type="button" class="chip" data-value="pb" aria-pressed="false">{{ blog.pb_name }}</button>
</div>
{%- endmacro %}

{# Filtres par catégorie #}
{% macro catFilters(target, countId, emptyId, categories, blog) -%}
<div class="filters" role="group" aria-label="Filtrer" data-filter-group data-filter-key="cat" data-filter-target="{{ target }}" data-filter-count="{{ countId }}" data-filter-empty="{{ emptyId }}">
  <button type="button" class="chip" data-value="all" aria-pressed="true">{{ blog.filter_all_themes }}</button>
  {%- for c in categories %}
  <button type="button" class="chip" data-value="{{ c.slug }}" aria-pressed="false">{{ c.name }}</button>
  {%- endfor %}
</div>
{%- endmacro %}

{# Bandeau contact / devis #}
{% macro contactBand(site, common) -%}
<section class="contact-band" aria-labelledby="cb-title">
  <div class="wrap">
    <div>
      <h2 class="display h-2" id="cb-title">{{ common.contact_band_title }}<br><span>{{ common.contact_band_highlight }}</span></h2>
      <p class="lead" style="margin-top:14px">{{ common.contact_band_text }}</p>
    </div>
    <a class="btn btn-yellow" href="/contact/{{ '?type=devis' if site.devis }}">{{ common.menu_devis_button if site.devis else common.menu_contact_button }} →</a>
  </div>
</section>
{%- endmacro %}
