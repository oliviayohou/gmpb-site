---
layout: layouts/base.njk
activeNav: pb
permalink: /petit-budget/
eleventyComputed:
  title: "{{ blog.pb_name }}"
  description: "{{ blog.pb_description }}"
---
{%- import "partials/macros.njk" as m -%}
{%- set arts = collections.articles | byTrack("pb") -%}
<section class="page-hero" style="background:#4169E1;color:#FFFFFF">
  <div class="wrap">
    <div class="breadcrumb"><a href="/">{{ common.breadcrumb_home }}</a> / {{ blog.pb_name }}</div>
    <h1 class="display h-1">{{ blog.pb_name }}</h1>
    <p class="lead" style="margin-top:20px">{{ blog.pb_description | rich | safe }}</p>
    <div class="btn-row"><a class="btn" href="/gros-budget/">{{ blog.see_also }} {{ blog.gm_name }} →</a></div>
  </div>
</section>
<section class="wrap" style="padding-top:40px;padding-bottom:88px" aria-label="{{ blog.pb_name }}">
  <div class="section-head" style="flex-direction:column;align-items:flex-start">
    {{ m.catFilters("track-grid", "track-count", "track-empty", categories.categories, blog) }}
    <span class="result-count" id="track-count" aria-live="polite"></span>
  </div>
  <div class="grid" id="track-grid">
    {%- for a in arts %}
    {{ m.card(a, categories.categories, blog, true) }}
    {%- endfor %}
  </div>
  <p class="empty" id="track-empty" {% if arts.length %}hidden{% endif %}>{{ blog.empty_track }}</p>
</section>
{{ m.contactBand(site, common) }}
