---
layout: layouts/base.njk
isHome: true
permalink: /
---
{%- import "partials/macros.njk" as m -%}
{%- set f = collections.articles | featuredFirst -%}
<section class="wrap hero">
  <div class="hero-title">
    <div class="hero-badges">{{ m.badge("gm") }}{{ m.badge("pb") }}</div>
    <h1 class="display h-hero">Grand <span class="nowrap">marketing &amp;</span><br><span class="highlight">petit budget.</span></h1>
  </div>
  <div class="hero-side">
    <p class="lead">{{ home.hero_text }}</p>
    <div class="btn-row">
      {%- if f %}<a class="btn btn-violet" href="{{ f.url }}">Lire le dernier décryptage</a>{% endif %}
      <a class="btn" href="/blog/">Explorer le blog</a>
    </div>
  </div>
</section>

{%- if f %}
{%- set fcat = f.data.category | category(categories.categories) %}
<section class="wrap" style="padding-bottom:72px" aria-label="Article à la une">
  <a class="featured" href="{{ f.url }}">
    {{ m.coverBox(f, fcat) }}
    <div class="featured-body">
      <div class="card-meta">{{ m.badge(f.data.track) }}<span>{{ fcat.name }} · {{ f | readingTime }} min</span></div>
      <p class="eyebrow" style="margin:0">À la une</p>
      <h2 class="display h-3" style="line-height:1.05">{{ f.data.title }}</h2>
      {%- if f.data.chapo %}<p class="muted">{{ f.data.chapo | truncate(170) }}</p>{% endif %}
      <span class="link-arrow">Lire l'article →</span>
    </div>
  </a>
</section>
{%- endif %}

{%- set latest = collections.articles | exceptUrl(f.url if f else "") | head(6) %}
{%- if latest.length %}
<section class="wrap" style="padding-bottom:80px" aria-labelledby="latest-title">
  <div class="section-head">
    <h2 class="display h-2" id="latest-title">Derniers articles</h2>
    {{ m.trackFilters("home-grid", "home-count", "home-empty") }}
  </div>
  <div class="grid" id="home-grid">
    {%- for a in latest %}
    {{ m.card(a, categories.categories) }}
    {%- endfor %}
  </div>
  <p class="empty" id="home-empty" hidden>Aucun article pour ce filtre pour l'instant.</p>
  <p class="sr-only" id="home-count" aria-live="polite"></p>
  <div style="margin-top:40px;text-align:center"><a class="btn" href="/blog/">Voir tous les articles</a></div>
</section>
{%- endif %}

<section class="intro-band" aria-labelledby="intro-title">
  <div class="wrap intro">
    <div class="intro-photo">
      {%- if about.photo %}<img class="ph" src="{{ about.photo }}" alt="{{ site.author }}" style="padding:0;object-fit:cover;width:100%">{% else %}<div class="ph">[Ta photo]</div>{% endif %}
    </div>
    <div class="intro-text">
      <p class="eyebrow">Derrière GM.PB</p>
      <h2 class="display h-2" id="intro-title" style="line-height:1.18">Le marketing des grandes marques, <span class="highlight nowrap">traduit pour toi.</span></h2>
      <p class="lead">{{ home.intro_text }}</p>
      <div class="intro-tracks">
        <div>{{ m.badge("gm") }}<p>Le décryptage : la cible, le timing, la mécanique.</p></div>
        <div>{{ m.badge("pb") }}<p>La version à appliquer chez toi, étape par étape.</p></div>
      </div>
      <div class="btn-row"><a class="btn btn-dark" href="/a-propos/">En savoir plus</a><a class="btn" href="/contact/{{ '?type=devis' if site.devis }}">{{ "Demander un devis" if site.devis else "Me contacter" }}</a></div>
    </div>
  </div>
</section>

<section class="section section-dark" aria-labelledby="themes-title">
  <div class="wrap">
    <h2 class="display h-2" id="themes-title" style="margin-bottom:32px">Explorer par thème</h2>
    <div class="cat-tiles">
      {%- for c in categories.categories %}
      <a class="cat-tile" href="/categorie/{{ c.slug }}/"><span>{{ c.name }}</span><span class="arrow" style="background:{{ c.color }}" aria-hidden="true">→</span></a>
      {%- endfor %}
    </div>
  </div>
</section>

{{ m.contactBand(site) }}
