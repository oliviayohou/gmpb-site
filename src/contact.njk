---
layout: layouts/base.njk
activeNav: contact
permalink: /contact/
eleventyComputed:
  title: "{{ contact.page_title }}"
  description: "{{ contact.page_description }}"
---
<div class="wrap contact-layout">
  <div class="contact-side">
    <p class="eyebrow">{{ contact.eyebrow_devis if site.devis else contact.eyebrow }}</p>
    <h1 class="display h-1" style="margin-bottom:24px">{{ contact.title }}<br><span class="highlight">{{ contact.title_highlight }}</span></h1>
    <p class="lead" style="margin-bottom:28px">{{ contact.intro | rich | safe }}</p>
    {%- if site.linkedin %}<a class="info" href="{{ site.linkedin }}" target="_blank" rel="noopener">{{ contact.linkedin_link }} <span aria-hidden="true">→</span></a>{% endif %}
    <a class="info" href="/a-propos/">{{ contact.about_link }} <span aria-hidden="true">→</span></a>
  </div>
  <div class="contact-card">
    <form class="form" id="contact-form" action="https://api.web3forms.com/submit" method="post" novalidate data-key="{{ site.web3formsKey }}">
      <input type="hidden" name="access_key" value="{{ site.web3formsKey }}">
      <input type="hidden" name="subject" value="{{ contact.email_subject }}">
      <input type="hidden" name="from_name" value="{{ site.shortTitle }}">
      <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true">
      {%- if site.devis %}
      <fieldset>
        <legend>{{ contact.mode_legend }}</legend>
        <div class="mode-switch">
          <button type="button" data-mode="question" aria-pressed="true">{{ contact.mode_question }}</button>
          <button type="button" data-mode="devis" aria-pressed="false">{{ contact.mode_devis }}</button>
        </div>
        <input type="hidden" name="type" id="c-type" value="{{ contact.mode_question }}">
      </fieldset>
      {%- endif %}
      <div class="fields-2">
        <div class="field"><label for="c-name">{{ contact.label_name }} *</label><input id="c-name" name="name" type="text" autocomplete="given-name" required></div>
        <div class="field"><label for="c-email">{{ contact.label_email }} *</label><input id="c-email" name="email" type="email" autocomplete="email" required></div>
      </div>
      {%- if site.devis %}
      <div class="devis-fields" id="devis-fields" hidden>
        <fieldset>
          <legend style="font-size:14px;font-weight:600">{{ contact.devis_need_legend }}</legend>
          {%- for n in contact.devis_needs %}
          <label class="radio"><input type="radio" name="besoin" value="{{ n }}"{% if loop.first %} checked{% endif %}> {{ n }}</label>
          {%- endfor %}
        </fieldset>
        <div class="field"><label for="c-biz">{{ contact.label_activity }} *</label><input id="c-biz" name="activite" type="text" placeholder="{{ contact.placeholder_activity }}" required></div>
        <div class="fields-2">
          <div class="field"><label for="c-when">{{ contact.label_when }}</label>
            <select id="c-when" name="delai">{% for o in contact.when_options %}<option>{{ o }}</option>{% endfor %}</select></div>
          <div class="field"><label for="c-budget">{{ contact.label_budget }}</label>
            <select id="c-budget" name="budget">{% for o in contact.budget_options %}<option>{{ o }}</option>{% endfor %}</select></div>
        </div>
      </div>
      {%- endif %}
      <div class="field"><label for="c-msg" id="msg-label">{{ contact.label_message }} *</label><textarea id="c-msg" name="message" rows="5" required></textarea></div>
      <label class="check"><input type="checkbox" name="consentement" value="oui" required><span>{{ contact.consent_text }} <a href="/confidentialite/" style="text-decoration:underline">{{ contact.consent_link }}</a>). *</span></label>
      <p class="error" id="contact-error" role="alert" hidden></p>
      <div><button type="submit" class="btn btn-violet" id="contact-submit">{{ contact.button_send }}</button></div>
    </form>
    <div class="sent" id="contact-sent" hidden>
      <span class="badge badge-gm">{{ contact.sent_badge }}</span>
      <h2 class="display h-2" tabindex="-1">{{ contact.sent_title }}</h2>
      <p class="lead" id="sent-text">{{ contact.sent_text }}</p>
      <button type="button" class="btn" id="contact-again">{{ contact.sent_again }}</button>
    </div>
  </div>
</div>
